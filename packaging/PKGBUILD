# Maintainer: Fred Book <claude@nianticbooks.com>
pkgname=stead-git
pkgver=0.1.0.r11.618e239
pkgrel=1
pkgdesc='Your mail stays home. Dark-mode, AI-native desktop email and calendar client (IMAP, CalDAV, Google Calendar)'
arch=('x86_64')
url='https://github.com/NianticBooks/Stead-Mail'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl' 'libsecret')
makedepends=('git' 'rust' 'nodejs' 'npm')
optdepends=('ollama: local model for triage and event extraction (AI is off by default)'
            'gnome-keyring: store passwords in the Secret Service instead of an encrypted file')
# makepkg's default LTO turns the C parts of ring and bundled SQLite into bitcode that rust-lld cannot link.
options=('!lto')
provides=('stead')
conflicts=('stead')
# STEAD_SRC lets you build a local checkout: STEAD_SRC=/path/to/Stead-Mail makepkg -f
source=("stead::git+${STEAD_SRC:-$url.git}")
sha256sums=('SKIP')

pkgver() {
  cd stead
  printf '%s.r%s.%s' "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd stead
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  (cd apps/desktop && npm ci --no-audit --no-fund)
}

build() {
  cd stead
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  (cd apps/desktop && npm run build)
  cargo build --release --locked -p stead-cli -p desktop --features desktop/custom-protocol
}

check() {
  cd stead
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --release --locked -p stead
}

package() {
  cd stead
  install -Dm755 target/release/stead "$pkgdir/usr/bin/stead"
  install -Dm755 target/release/desktop "$pkgdir/usr/bin/stead-desktop"
  install -Dm644 packaging/stead.desktop "$pkgdir/usr/share/applications/stead.desktop"
  install -Dm644 apps/desktop/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/stead.png"
  install -Dm644 apps/desktop/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/stead.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
